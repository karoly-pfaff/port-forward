{
  "name": "portier",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "format": "node scripts/format-source.js",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run build:shared && npm run build:server && npm run build:client && npm run build:service",
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "build:service": "go -C service build -o build/portier-service ./sources",
    "start:dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "start:server": "node server/build/index.js --service --static-dir client/build",
    "start:service": "go -C service run ./sources --static-dir ../client/build",
    "test": "npm run test:shared && npm run test:server && npm run test:client && npm run test:service",
    "test:shared": "npm test -w shared",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "test:service": "go -C service test ./...",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fresh": "npm run build:client && playwright test",
    "test:e2e:install": "playwright install chromium",
    "build:runtime": "npm run check && node scripts/build-runtime.js",
    "build:runtime:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/build-runtime.ps1",
    "build:runtime:macos": "bash scripts/macos/build-runtime.sh",
    "build:runtime:linux": "bash scripts/linux/build-runtime.sh",
    "build:clean": "node scripts/clean-build.js",
    "validate:runtime": "node scripts/validate-runtime.js",
    "validate:runtime:build": "node scripts/validate-runtime.js --build",
    "validate:runtime:smoke": "node scripts/validate-runtime.js --build --smoke",
    "validate:runtime:behavior": "npm run validate:binary",
    "validate:service:windows:user": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service/validate-user-install.ps1",
    "validate:service:windows:machine": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service/validate-machine-service.ps1",
    "validate:service:macos": "bash scripts/macos/service/validate-launch-agent.sh",
    "validate:service:linux": "bash scripts/linux/service/validate-systemd-service.sh",
    "validate:service:current": "node scripts/validate-service.js",
    "validate:config": "node scripts/validate-config.js",
    "validate:contract": "node scripts/validate-contract.js",
    "validate:binary": "node scripts/validate-binary.js",
    "validate:scripts": "node scripts/validate-scripts.js",
    "build:release": "node scripts/build-release.js --current-platform",
    "build:release:current": "node scripts/build-release.js --current-platform",
    "build:release:portable": "node scripts/build-release.js --current-platform --portable-only",
    "validate:release": "node scripts/validate-release.js --platform current",
    "validate:release:current": "node scripts/validate-release.js --platform current",
    "validate:release:portable": "node scripts/validate-release.js --platform current --portable-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
