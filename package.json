{
  "name": "portier",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run build:shared && npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "format": "node scripts/format-source.js",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run build:shared && npm run build:server && npm run build:client && npm run build:service",
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "build:service": "go -C service build -o build/portier-service ./sources",
    "build:cli": "go -C tools/cli build -o build/portier-cli ./sources",
    "build:replay": "go -C tools/replay build -o build/replay ./sources",
    "start:dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "apidoc:generate": "npm run apidoc:generate -w server",
    "apidoc:release": "npm run apidoc:release -w server",
    "start:server": "node server/build/index.js --service --static-dir client/build",
    "start:service": "go -C service run ./sources --static-dir ../client/build",
    "test": "npm run test:shared && npm run test:server && npm run test:client && npm run test:service",
    "test:shared": "npm test -w shared",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "test:service": "node scripts/coverage-service.js --test-only",
    "test:cli": "go -C tools/cli test ./...",
    "test:replay": "go -C tools/replay test ./...",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fresh": "npm run build:client && playwright test",
    "test:e2e:install": "playwright install chromium",
    "coverage": "npm run coverage:project",
    "coverage:project": "npm run coverage:shared && npm run coverage:server && npm run coverage:client && npm run coverage:service && npm run coverage:cli",
    "coverage:shared": "npm run coverage -w shared",
    "coverage:server": "npm run coverage -w server",
    "coverage:client": "npm run coverage -w client",
    "coverage:service": "node scripts/coverage-service.js",
    "coverage:cli": "node scripts/coverage-tools-cli.js",
    "coverage:replay": "node scripts/coverage-tools-replay.js",
    "validate:coverage": "node scripts/validate-coverage.js",
    "validate:coverage:shared": "node scripts/validate-coverage.js --only shared",
    "validate:coverage:server": "node scripts/validate-coverage.js --only server",
    "validate:coverage:client": "node scripts/validate-coverage.js --only client",
    "validate:coverage:service": "node scripts/validate-coverage.js --only service",
    "validate:coverage:cli": "node scripts/validate-coverage.js --only cli",
    "validate:coverage:replay": "node scripts/validate-coverage.js --only replay",
    "build:runtime": "npm run check && node scripts/build-runtime.js",
    "build:runtime:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/build-runtime.ps1",
    "build:runtime:macos": "bash scripts/macos/build-runtime.sh",
    "build:runtime:linux": "bash scripts/linux/build-runtime.sh",
    "build:clean": "node scripts/clean-build.js",
    "validate:runtime": "node scripts/validate-runtime.js",
    "validate:runtime:build": "node scripts/validate-runtime.js --build",
    "validate:runtime:smoke": "node scripts/validate-runtime.js --build --smoke",
    "validate:runtime:recovery-smoke": "node scripts/validate-runtime.js --build --recovery-smoke",
    "validate:runtime:behavior": "npm run validate:binary",
    "validate:service:windows:user": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service/validate-user-install.ps1",
    "validate:service:windows:machine": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service/validate-machine-service.ps1",
    "validate:service:macos": "bash scripts/macos/service/validate-launch-agent.sh",
    "validate:service:linux": "bash scripts/linux/service/validate-systemd-service.sh",
    "validate:service:current": "node scripts/validate-service.js",
    "validate:config": "node scripts/validate-config.js",
    "validate:contract": "node scripts/validate-contract.js",
    "validate:openapi:go": "go -C service test -count=1 -tags openapi_inventory -run TestGoAPIInventoryMatchesOpenAPI ./sources/api/",
    "validate:binary": "node scripts/validate-binary.js",
    "validate:scripts": "node scripts/validate-scripts.js",
    "validate:cli": "npm run test:cli && npm run build:cli",
    "validate:replay": "npm run test:replay && npm run build:replay",
    "build:release": "node scripts/build-release.js --current-platform",
    "build:release:current": "node scripts/build-release.js --current-platform",
    "build:release:portable": "node scripts/build-release.js --current-platform --portable-only",
    "build:release:portable:all": "node scripts/build-portable.js --all",
    "build:release:windows": "node scripts/build-portable.js --windows",
    "build:release:linux": "node scripts/build-portable.js --linux",
    "build:release:macos": "node scripts/build-portable.js --macos",
    "validate:release": "node scripts/validate-release.js --platform current",
    "validate:release:current": "node scripts/validate-release.js --platform current",
    "validate:release:portable": "node scripts/validate-release.js --platform current --portable-only",
    "validate:release:portable:all": "node scripts/validate-portable.js --all",
    "validate:release:portable:windows": "node scripts/validate-portable.js --windows",
    "validate:release:portable:linux": "node scripts/validate-portable.js --linux",
    "validate:release:portable:macos": "node scripts/validate-portable.js --macos",
    "validate:release:checksums": "node scripts/validate-release.js --platform current --checksums-only",
    "validate:upgrade:current": "node scripts/validate-upgrade.js",
    "validate:msi:install": "node scripts/validate-msi-install.js --extract",
    "validate:msi:install:full": "node scripts/validate-msi-install.js --full",
    "validate:pkg:install": "node scripts/validate-pkg-install.js",
    "validate:deb:install": "node scripts/validate-deb-install.js",
    "validate:rpm:payload": "node scripts/validate-rpm-payload.js",
    "validate:rpm:install": "node scripts/validate-rpm-install.js",
    "validate:artifacts": "node scripts/validate-artifacts.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.6",
    "adm-zip": "^0.5.17",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "tar-stream": "^3.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
