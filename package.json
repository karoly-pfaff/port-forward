{
  "name": "portier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "format": "node scripts/format-source.js",
    "check": "npm run lint && npm run typecheck && npm run test",
    "build": "npm run build:shared && npm run build:server && npm run build:client && npm run build:service",
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "build:service": "go -C service build -o build/portier-service ./sources",
    "start:dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "start:server": "node server/build/index.js --service --static-dir client/build",
    "start:service": "go -C service run ./sources --static-dir ../client/build",
    "test": "npm run test:shared && npm run test:server && npm run test:client && npm run test:service",
    "test:shared": "npm test -w shared",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "test:service": "go -C service test ./...",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fresh": "npm run build:client && playwright test",
    "test:e2e:install": "playwright install chromium",
    "package:portier": "npm run check && node scripts/package-current.js",
    "package:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/build-executable.ps1",
    "package:macos": "bash scripts/macos/build-package.sh",
    "package:linux": "bash scripts/linux/build-package.sh",
    "package:clean": "node -e \"import('fs').then(fs => ['build/portier','build/windows','build/macos','build/linux'].forEach(d => fs.default.rmSync(d, {recursive:true,force:true})))\"",
    "validate:package": "node scripts/validate-package.js",
    "validate:package:build": "node scripts/validate-package.js --build",
    "validate:package:smoke": "node scripts/validate-package.js --build --smoke",
    "validate:service:windows:user": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/validate-user-install.ps1",
    "validate:service:windows:machine": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/validate-machine-service.ps1",
    "validate:service:macos": "bash scripts/macos/validate-launch-agent.sh",
    "validate:service:linux": "bash scripts/linux/validate-systemd-service.sh",
    "validate:service:current": "node scripts/validate-service.js",
    "installer:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/installer/build-installer.ps1",
    "installer:windows:no-package": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/installer/build-installer.ps1 -NoPackage",
    "installer:macos": "bash scripts/macos/build-release.sh",
    "installer:macos:no-package": "bash scripts/macos/build-release.sh --no-package",
    "installer:linux": "bash scripts/linux/build-release.sh",
    "installer:linux:no-package": "bash scripts/linux/build-release.sh --no-package",
    "package:release": "node scripts/package-release.js --current-platform",
    "package:release:current": "node scripts/package-release.js --current-platform",
    "package:release:portable": "node scripts/package-release.js --current-platform --portable-only",
    "validate:release": "node scripts/validate-artifacts.js",
    "validate:release:current": "node scripts/validate-artifacts.js --platform current",
    "validate:release:portable": "node scripts/validate-artifacts.js --platform current --portable-only"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
