<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.portier.port-forwarding</string>
	<key>ProgramArguments</key>
	<array>
		<!-- Go service mode: replace YOUR_USERNAME with your macOS username -->
		<string>/Users/YOUR_USERNAME/Applications/Portier/service</string>
		<!-- Node.js fallback mode: replace the line above with these two lines instead:
		<string>/usr/local/bin/node</string>
		<string>/Users/YOUR_USERNAME/Applications/Portier/server.js</string>
		-->
		<string>--service</string>
		<string>--config</string>
		<string>/Users/YOUR_USERNAME/Library/Application Support/Portier/rules.json</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>47831</string>
		<string>--static-dir</string>
		<string>/Users/YOUR_USERNAME/Applications/Portier/web</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/Applications/Portier</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/Portier/portier.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/Portier/portier.err.log</string>
</dict>
</plist>
