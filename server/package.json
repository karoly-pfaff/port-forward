{
  "name": "@portier/server",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch sources/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "apidoc:generate": "tsx sources/openapi/generate.ts",
    "apidoc:release": "tsx sources/openapi/release.ts",
    "test": "vitest run sources",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@portier/shared": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.2",
    "tsx": "^4.23.15"
  }
}
