{
  "name": "@portier/server",
  "version": "1.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch sources/index.ts",
    "dev:legacy": "tsx watch sources/legacy/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "start:nest": "tsx sources/index.ts",
    "start:legacy": "node build/legacy/index.js",
    "generate:apidoc": "tsx sources/nest/openapi/generate.ts",
    "test": "vitest run sources",
    "test:nest": "vitest run sources/nest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.4",
    "@portier/shared": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "tsx": "^4.19.4"
  }
}
